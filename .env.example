# Kết nối Postgres (mặc định dùng DB local mgm_max)
DATABASE_URL=postgres://localhost:5432/mgm_max
# Mật khẩu đăng nhập trang /admin
ADMIN_MAT_KHAU=mgmmax123
# (Tuỳ chọn) Gửi email thật qua Resend; bỏ trống = chế độ giả lập, xem email trong Admin > Email
RESEND_API_KEY=
# (Tuỳ chọn) Địa chỉ from khi gửi thật
EMAIL_FROM=MGM MAX <onboarding@resend.dev>
# Referral AI — sinh chiến dịch bằng Claude
# Mặc định dùng Claude CLI gói SUBSCRIPTION (không tốn phí API): trên máy chủ chạy `claude` rồi /login.
# Ép chế độ: cli (gói sub) hoặc api (dùng key bên dưới). Bỏ trống = tự chọn (có key thì api, không thì cli).
MGM_AI_MODE=
# (Tuỳ chọn) Model cho AI — mặc định claude-opus-5
CLAUDE_MODEL=
# (Tuỳ chọn) Chỉ cần khi MGM_AI_MODE=api
ANTHROPIC_API_KEY=
